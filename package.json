  "version": "0.0.0",
  "homepage": "https://abhinaykumarchaluvadi-glitch.github.io/Hotel-Mangment",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:setup": "python -m venv venv && venv\\Scripts\\pip install -r requirements.txt",
