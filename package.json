    "build": "tsc -b && vite build",
    "build:ghpages": "tsc -b && vite build --base /Hotel-Mangment/",
    "predeploy": "npm run build:ghpages",
    "deploy": "gh-pages -d dist",
    "vercel-build": "npm run build",
    "lint": "eslint .",
